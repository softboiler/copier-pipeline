[build-system]
requires = ["uv-build==0.6.16"]
build-backend = "uv_build"

[project]
name = "{{ project_name }}-dev"
version = "0.0.0"
requires-python = ">=3.11"
dependencies = [
  "cappa>=0.26.4",
  "cyclopts>=3.14.2",
  "dulwich>=0.22.1",
  # ? Docs
  "ruamel-yaml>=0.18.6",
]
[project.scripts]
{{ project_name }}-dev = "{{ package_name }}_dev.__main__:main"

[tool.fawltydeps]
deps = ["packages/_dev/pyproject.toml"]
code = ["packages/_dev", "docs", "tests"]
ignore_undeclared = ["{{ package_name }}"]
[tool.fawltydeps.custom_mapping]
ruamel-yaml = ["ruamel"]
