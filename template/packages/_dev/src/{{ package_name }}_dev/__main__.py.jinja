"""Command-line interface."""

from cappa.base import command, invoke
from cappa.subcommand import Subcommands


@command(invoke="{{ package_name }}_dev.tools.add_change")
class AddChange:
    """Add change."""


@command(invoke="{{ package_name }}_dev.tools.get_actions")
class GetActions:
    """Get actions used by this repository."""


@command(invoke="{{ package_name }}_dev.tools.sync_local_dev_configs")
class SyncLocalDevConfigs:
    """Synchronize local dev configs."""


@command()
class Dev:
    """Dev tools."""

    commands: Subcommands[AddChange | GetActions | SyncLocalDevConfigs]


def main():
    """CLI entry-point."""
    invoke(Dev)


if __name__ == "__main__":
    main()
